# 50 MS/s diagnostic, fixed verified connector placement, PDN=T11.
set_property PACKAGE_PIN U18 [get_ports board_clk_0]
set_property IOSTANDARD LVCMOS33 [get_ports board_clk_0]
create_clock -name board25 -period 40.000 [get_ports board_clk_0]
set_property PACKAGE_PIN Y6 [get_ports {adc_data_0[0]}]
set_property PACKAGE_PIN Y7 [get_ports {adc_data_0[1]}]
set_property PACKAGE_PIN V6 [get_ports {adc_data_0[2]}]
set_property PACKAGE_PIN W6 [get_ports {adc_data_0[3]}]
set_property PACKAGE_PIN T9 [get_ports {adc_data_0[4]}]
set_property PACKAGE_PIN U10 [get_ports {adc_data_0[5]}]
set_property PACKAGE_PIN U8 [get_ports {adc_data_0[6]}]
set_property PACKAGE_PIN U9 [get_ports {adc_data_0[7]}]
set_property PACKAGE_PIN V8 [get_ports {adc_data_0[8]}]
set_property PACKAGE_PIN W8 [get_ports {adc_data_0[9]}]
set_property PACKAGE_PIN U7 [get_ports {adc_data_0[10]}]
set_property PACKAGE_PIN V7 [get_ports {adc_data_0[11]}]
set_property PACKAGE_PIN T5 [get_ports {adc_data_0[12]}]
set_property PACKAGE_PIN U5 [get_ports {adc_data_0[13]}]
set_property PACKAGE_PIN V5 [get_ports adc_otr_0]
# J4-2 = B34_L1P = T11. T10 is L1N / camera SCL, not J4-2.
set_property PACKAGE_PIN T11 [get_ports adc_pwdn_0]
set_property PACKAGE_PIN Y9 [get_ports adc_clk_0]
set_property PACKAGE_PIN Y8 [get_ports adc_oeb_0]
set_property PACKAGE_PIN W10 [get_ports {grounded_pads_0[0]}]
set_property PACKAGE_PIN W9 [get_ports {grounded_pads_0[1]}]
set_property IOSTANDARD LVCMOS33 [get_ports {adc_data_0[*] adc_otr_0 grounded_pads_0[*] adc_clk_0 adc_oeb_0 adc_pwdn_0}]
set_property DRIVE 8 [get_ports {adc_clk_0 adc_oeb_0 adc_pwdn_0}]
set_property SLEW SLOW [get_ports {adc_clk_0 adc_oeb_0 adc_pwdn_0}]
# Raw oversampling intentionally includes transition samples; only stable
# phase 1/3 words are used offline at raw 200 MHz. External flight times
# have not been measured; this remains a diagnostic, not I/O timing signoff.
set_false_path -from [get_ports {adc_data_0[*] adc_otr_0 grounded_pads_0[*]}]
set_false_path -to [get_ports {adc_clk_0 adc_oeb_0 adc_pwdn_0}]

set_property -dict {PACKAGE_PIN J18 IOSTANDARD TMDS_33} [get_ports tmds_clk_p_0]
set_property -dict {PACKAGE_PIN H18 IOSTANDARD TMDS_33} [get_ports tmds_clk_n_0]
set_property -dict {PACKAGE_PIN J20 IOSTANDARD TMDS_33} [get_ports {tmds_data_p_0[2]}]
set_property -dict {PACKAGE_PIN H20 IOSTANDARD TMDS_33} [get_ports {tmds_data_n_0[2]}]
set_property -dict {PACKAGE_PIN K19 IOSTANDARD TMDS_33} [get_ports {tmds_data_p_0[1]}]
set_property -dict {PACKAGE_PIN J19 IOSTANDARD TMDS_33} [get_ports {tmds_data_n_0[1]}]
set_property -dict {PACKAGE_PIN G19 IOSTANDARD TMDS_33} [get_ports {tmds_data_p_0[0]}]
set_property -dict {PACKAGE_PIN G20 IOSTANDARD TMDS_33} [get_ports {tmds_data_n_0[0]}]
