set_false_path -to [get_pins -hier -regexp {.*hdmi_scanout.*/vs_sync_reg\[0\]/D}]
set_false_path -to [get_pins -hier -regexp {.*hdmi_scanout.*/uf_sync_reg\[0\]/D}]
set_max_delay -datapath_only 10.000 -from [get_cells -hier -regexp {.*hdmi_scanout.*/wgray_reg\[[0-9]+\]}] -to [get_pins -hier -regexp {.*hdmi_scanout.*/wg0_reg\[[0-9]+\]/D}]
set_bus_skew 10.000 -from [get_cells -hier -regexp {.*hdmi_scanout.*/wgray_reg\[[0-9]+\]}] -to [get_pins -hier -regexp {.*hdmi_scanout.*/wg0_reg\[[0-9]+\]/D}]
set_max_delay -datapath_only 10.000 -from [get_cells -hier -regexp {.*hdmi_scanout.*/rgray_reg\[[0-9]+\]}] -to [get_pins -hier -regexp {.*hdmi_scanout.*/rg0_reg\[[0-9]+\]/D}]
set_bus_skew 10.000 -from [get_cells -hier -regexp {.*hdmi_scanout.*/rgray_reg\[[0-9]+\]}] -to [get_pins -hier -regexp {.*hdmi_scanout.*/rg0_reg\[[0-9]+\]/D}]
set_false_path -to [get_pins -hier -regexp {.*hdmi_scanout.*/mode_sync_reg\[0\]/D}]
set_false_path -to [get_pins -hier -regexp {.*hdmi_scanout.*/cursor_sync_reg\[0\]/D}]
